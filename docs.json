{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Scott AI",
  "colors": {
    "primary": "#2580F5",
    "light": "#3B82F6",
    "dark": "#1D6FE0"
  },
  "font": {
    "headings": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "css": "/custom.css",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/concepts"
            ]
          },
          {
            "group": "Teams",
            "pages": [
              "planspaces/overview",
              "planspaces/documents",
              "collaboration/comments",
              "collaboration/reviews",
              "collaboration/sharing",
              "collaboration/notifications",
              "collaboration/pulse"
            ]
          },
          {
            "group": "Scott CLI",
            "pages": [
              "developer-tools/cli",
              "developer-tools/sync",
              "developer-tools/push",
              "developer-tools/pull",
              "developer-tools/setup"
            ]
          },
          {
            "group": "Scott GitHub App",
            "pages": [
              "developer-tools/github-app",
              "developer-tools/scott-ci",
              "planspaces/connected-sources"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "The Scott Method",
          "href": "https://tryscott.ai/method",
          "icon": "book-open"
        },
        {
          "anchor": "App",
          "href": "https://tryscott.ai",
          "icon": "globe"
        },
        {
          "anchor": "Install",
          "href": "/getting-started/quickstart#start-with-sync",
          "icon": "terminal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tryscott.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.tryscott.ai/login"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/scott_ai_"
    }
  },
  "rounded": "default"
}
